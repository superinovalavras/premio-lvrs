# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Somente servidor — nunca prefixar com NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=

# Segredo do HMAC do CPF (>= 32 caracteres). Gere com: openssl rand -hex 32
# Trocar este valor depois que a votação começar invalida a trava de 1 voto por CPF.
CPF_HASH_SECRET=

# Cloudflare Turnstile (dash.cloudflare.com > Turnstile)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Só desenvolvimento local: destrava o formulário fora de 06-11/11/2026
# NEXT_PUBLIC_VOTACAO_PREVIEW=1
# VOTACAO_FORCAR_ABERTA=1
